# MySQL connection string
DATABASE_URL="mysql://root:@localhost:3306/top_companies"

# Server
PORT=4000
NODE_ENV=development
API_BASE_URL="http://localhost:4000"

# CORS - the browser only ever sees http://localhost:3000 (admin is proxied
# there under /admin via apps/web's rewrites); :3002 is kept for direct
# access to the admin app while developing.
ADMIN_ORIGIN="http://localhost:3000,http://localhost:3002"

# JWT secrets - replace with long random strings in production
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN_DAYS=30

# Password reset
PASSWORD_RESET_EXPIRES_IN_MINUTES=60
ADMIN_RESET_PASSWORD_URL="http://localhost:3000/admin/reset-password"

# Mailer (dev mode uses jsonTransport and logs to console; set SMTP_* to send real email)
MAIL_FROM="Top Companies <no-reply@topcompanies.dev>"
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Uploads
MAX_UPLOAD_SIZE_MB=5
